# ============================================
# PickupLocker - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# For Vercel deployment, add ALL of these in Project Settings > Environment Variables.

# ---- DATABASE (REQUIRED) ----
# PostgreSQL connection string (required for production)
DATABASE_URL="postgresql://user:password@host:5432/pickuplocker?schema=public"
# Direct connection for Prisma migrations (Vercel requires this)
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/pickuplocker?schema=public"

# ---- AUTHENTICATION (REQUIRED) ----
# Secret key for JWT signing - use a long random string (32+ chars)
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# HMAC secret for courier PIN hashing - use a different random string
NEXTAUTH_SECRET=""

# ---- ADMIN CREDENTIALS (REQUIRED) ----
# Dashboard login credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Optional operator account
OPERATOR_USERNAME=""
OPERATOR_PASSWORD=""

# Staff PINs (for kiosk dashboard access)
# STAFF_PIN_1="123456"
# STAFF_PIN_1_NAME="Staff User"
# STAFF_PIN_1_ROLE="OPERATOR"
# STAFF_PIN_2="789012"
# STAFF_PIN_2_NAME="Manager"
# STAFF_PIN_2_ROLE="ADMIN"

# ---- CRON SECURITY (REQUIRED) ----
# Secret key for cron job endpoints - use a random string
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ---- APP URL ----
NEXT_PUBLIC_APP_URL="https://pickupja.com"

# ---- EMAIL (Resend) ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL="system@pickupja.com"
RESEND_FROM_NAME="Pickup Jamaica"

# ---- BESTWOND (Locker Hardware API) ----
BESTWOND_APP_ID=""
BESTWOND_APP_SECRET=""
BESTWOND_DEVICE_ID="2100018247"

# ---- TEXTBEE (SMS Gateway) ----
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""

# ---- DIMEPAY (Payment Gateway) ----
DIMEPAY_LIVE_CLIENT_ID=""
DIMEPAY_LIVE_SECRET_KEY=""
DIMEPAY_SANDBOX_CLIENT_ID=""
DIMEPAY_SANDBOX_SECRET_KEY=""
# Set to "false" for production (live payments)
DIMEPAY_SANDBOX_MODE="true"
