<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for local development / fallback -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Explicit HTTPS config for production domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">pickuplocker.vercel.app</domain>
        <domain includeSubdomains="true">api.dimepay.app</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
